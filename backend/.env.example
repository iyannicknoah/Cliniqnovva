# Copy to .env.development / .env.staging / .env.production
# Each environment points at a SEPARATE Firebase project (see /firebase/.firebaserc)
# so dev data can never mix with staging or real clinic data in prod.

PORT=3000

# Firebase Admin SDK credentials — pick ONE of the two options below.

# Option A (simplest for local dev): path to the downloaded service-account JSON
# file (Firebase Console > Project Settings > Service Accounts > Generate new
# private key). If set, this takes priority over the discrete vars below.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option B: discrete env vars (better for CI/hosting providers that don't
# support file uploads, e.g. Railway/Render env var dashboards).
FIREBASE_PROJECT_ID=cliniqnovva-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@cliniqnovva-dev.iam.gserviceaccount.com
# Keep the literal \n escapes if pasting the key from the downloaded JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=cliniqnovva-dev.appspot.com

# SMS provider (fallback/critical alerts — spec section 6.11) — interface only for now, no vendor wired up
SMS_PROVIDER_API_KEY=

DEFAULT_LOCALE=en
